[Desktop Entry]
Type=Service
MimeType=application/x-ms-dos-executable;application/x-msdownload;application/vnd.microsoft.portable-executable;application/x-msi;application/x-bat;
Actions=runWindows;addToSteam;windowsSettings;
X-KDE-Priority=TopLevel
X-KDE-Submenu=Windows program

[Desktop Action runWindows]
Name=Run / install
Icon=wine
Exec=haven-run-exe %f

[Desktop Action addToSteam]
Name=Add game to Steam (runs with Proton)...
Icon=steam
Exec=steam steam://AddNonSteamGame

[Desktop Action windowsSettings]
Name=Windows program settings
Icon=preferences-system
Exec=haven-run-exe --settings
