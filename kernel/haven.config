# Haven OS kernel configuration fragment
# Merged on top of Arch Linux's stock config by PKGBUILD prepare().

# ---------------------------------------------------------------
# Windows compatibility
# ---------------------------------------------------------------
# NTSYNC: kernel implementation of Windows NT synchronisation
# primitives (mutexes, semaphores, events). Wine/Proton use
# /dev/ntsync to run Windows games with far lower overhead.
CONFIG_NTSYNC=m

# Needed by some anti-cheat / launchers and Proton's fsync path
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y

# Large memory mappings used by many modern Windows games
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Gamepads and controllers
CONFIG_HID_STEAM=m
CONFIG_HID_SONY=m
CONFIG_HID_NINTENDO=m
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y

# ---------------------------------------------------------------
# Gaming responsiveness
# ---------------------------------------------------------------
# BORE: Burst-Oriented Response Enhancer scheduler (CachyOS patch)
CONFIG_SCHED_BORE=y

# 1000Hz timer for smoother frame pacing and input latency
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# Full preemption for desktop/gaming latency
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y

# sched-ext so alternative BPF schedulers can be tried at runtime
CONFIG_SCHED_CLASS_EXT=y

# Compressed RAM swap
CONFIG_ZRAM=m
CONFIG_ZSWAP=y

# ---------------------------------------------------------------
# Privacy and security hardening
# ---------------------------------------------------------------
# AppArmor + Lockdown + Landlock available; the active list is set
# on the kernel command line by the installer.
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor,bpf"

# Zero memory on allocation (defeats some info leaks)
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y

# Randomise kernel stack offset per syscall
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y

# Harden usercopy and slab freelists
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y

# Don't let unprivileged users read kernel logs
CONFIG_SECURITY_DMESG_RESTRICT=y

# No legacy attack surface
CONFIG_LEGACY_TIOCSTI=n
CONFIG_X86_VSYSCALL_EMULATION=n

# ---------------------------------------------------------------
# Trim debugging overhead
# ---------------------------------------------------------------
CONFIG_SCHED_DEBUG=n
CONFIG_LATENCYTOP=n
